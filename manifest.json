{
  "manifest_version": 3,
  "name": "Second-Hand Finder",
  "version": "2.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.tradera.com/*",
    "*://*.blocket.se/*",
    "*://*.ebay.com/*",
    "*://*.ebay.se/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png",
    "default_width": 600,
    "default_height": 600
  }
}